{
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "redgym.it" }],
      "status": 302,
      "dest": "/maintenance.html"
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.redgym.it" }],
      "status": 302,
      "dest": "/maintenance.html"
    },

    { "handle": "filesystem" }
  ]
}