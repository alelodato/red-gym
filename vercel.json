{
  "routes": [
    { "handle": "filesystem" },

    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "www.redgym.it" }],
      "status": 302,
      "headers": { "Location": "/maintenance.html" }
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "redgym.it" }],
      "status": 302,
      "headers": { "Location": "/maintenance.html" }
    }
  ]
}